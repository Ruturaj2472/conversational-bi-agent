# OpenAI
OPENAI_API_KEY=sk-your-key-here

# PostgreSQL - Business Data DB (local, outside Docker)
# Use host.docker.internal to reach local Postgres from inside Docker
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=chinook

# PostgreSQL - Agent Memory DB (same local Postgres, different DB)
MEMORY_POSTGRES_HOST=host.docker.internal
MEMORY_POSTGRES_PORT=5432
MEMORY_POSTGRES_USER=postgres
MEMORY_POSTGRES_PASSWORD=yourpassword
MEMORY_POSTGRES_DB=agent_memory

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=bi-agent

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Agent settings
MAX_RESULTS=10
MODEL_NAME=gpt-4o
FAST_MODEL_NAME=gpt-4.1-mini
QUERY_TIMEOUT_SECONDS=30
