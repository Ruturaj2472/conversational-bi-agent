# OpenAI
OPENAI_API_KEY=sk-your-key-here

# PostgreSQL - Business Data DB
# docker compose runs Postgres itself and points the app at it.
# For a local (non-Docker) run, use POSTGRES_HOST=localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=northwind

# PostgreSQL - Agent Memory DB (same server, different DB)
# Unset MEMORY_POSTGRES_* values fall back to the POSTGRES_* values above.
MEMORY_POSTGRES_DB=agent_memory

# MLflow (docker compose sets this to the bundled MLflow server)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=bi-agent

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Agent settings
MAX_RESULTS=10
MODEL_NAME=gpt-4o
FAST_MODEL_NAME=gpt-4.1-mini
QUERY_TIMEOUT_SECONDS=30
HISTORY_MESSAGES=10
HISTORY_MAX_CHARS=500
